{
  "manifest_version": 3,
  "name": "Form Autofill",
  "version": "1.0.0",
  "description": "Automatically fill repetitive forms using saved user information.",
  "permission": ["activeTab", "storage", "scripting"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"]
    }
  ]
}
